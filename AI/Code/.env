# Copy this file to .env and fill in values. Never commit the real .env file.

APP_ENV=development
LOG_LEVEL=INFO

# --- LLM provider (wired up starting Day 3) ---
# Choose exactly one provider: gemini or groq
LLM_PROVIDER=gemini

# Google AI Studio free tier — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant